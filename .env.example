# Optional: enable online AI chat through the existing OpenAI-compatible routes.
# The referenced secret file must stay outside Git; secrets/ is ignored.
AMADEUS_API_KEY_FILE=secrets/apikey.txt
AMADEUS_AI_ROUTES_FILE=config/ai_routes.toml

# Optional: enable class timetable lookup through a protected JWGL session.
AMADEUS_JWGL_COOKIE_FILE=secrets/jwgl_cookie.txt

# Optional: used by the retained NoneBot course reminder service.
# AMADEUS_SEMESTER_START=2026-09-07
