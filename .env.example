# Online AI chat through the project's OpenAI-compatible routes.
# The referenced secret file must stay outside Git; secrets/ is ignored.
YOUXUEBAN_API_KEY_FILE=secrets/apikey.txt
YOUXUEBAN_AI_ROUTES_FILE=config/ai_routes.toml

# Class timetable lookup through a protected JWGL session.
YOUXUEBAN_JWGL_COOKIE_FILE=secrets/jwgl-cookie.txt

# Read-only information portal and Second Classroom data.
YOUXUEBAN_PORTAL_COOKIE_FILE=secrets/portal-cookie.txt
YOUXUEBAN_ACTIVITY_TOKEN_FILE=secrets/activity-token.txt
YOUXUEBAN_ACTIVITY_LIST_ENDPOINT=/api/v1/replace-with-confirmed-list-endpoint

# Electricity balance lookup through the official BUPT service. Browser
# development mode reads a short-lived local Cookie file; the packaged client
# manages credentials and encrypted sessions through its settings screen.
YOUXUEBAN_ELECTRICITY_COOKIE_FILE=secrets/electricity-cookie.txt
YOUXUEBAN_ELECTRICITY_QUERY_URL=https://app.bupt.edu.cn/buptdf/wap/default/chong

# First calendar day of academic week 1. The weekly grid still starts on Monday.
YOUXUEBAN_SEMESTER_START=2026-08-30
